# Copy to the project-root .env if desired. Missing keys are allowed.
# Environment variables override this file. Do not use frontend build variables for keys.
APP_PORT=8000
# Relative paths resolve against the project root, never the shell working directory.
# Local Python setting. Compose fixes DATA_DIR=/app/runtime inside the container.
DATA_DIR=data/runtime
GEMINI_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=
GENERATION_PROVIDER=gemini
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4

# Compose only: host port and bind source; container DATA_DIR stays /app/runtime.
HOST_PORT=8000
FRONTEND_PORT=8080
HOST_DATA_DIR=./data/runtime
